{
  "name": "cogby",
  "version": "0.3.11",
  "description": "Cogby, a personal brain for Claude Code: skills, the session hooks that load a brain's memory and wrap up its sessions, and the brain's own tools. Works on its own.",
  "author": {
    "name": "Yasser Mouhajir"
  },
  "skills": "./.claude/skills/",
  "mcpServers": {
    "cogby-brain": {
      "command": "node",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/core/brain/cli.cjs",
        "serve",
        "--mcp"
      ]
    }
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/.claude/hooks/plugin-hook.cjs\" brain-context"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/.claude/hooks/plugin-hook.cjs\" capture-log"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/.claude/hooks/plugin-hook.cjs\" session-wrapup"
          }
        ]
      }
    ]
  }
}
