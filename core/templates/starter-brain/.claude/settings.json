{
  "autoMemoryEnabled": false,
  "permissions": {
    "allow": [
      "Bash(git push:*)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push --force-with-lease:*)",
      "Bash(git push --mirror:*)",
      "Bash(git push --delete:*)"
    ]
  },
  "enabledPlugins": {
    "claude-security@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": true,
    "cogby@cogby": true
  }
}
